{
  "schema_format_version": 1,
  "default_height_field": "cpu-erosion-v1",
  "known_height_fields": ["cpu-erosion-v1", "cpu-terrain-v1", "cpu-ref-height-v2", "cpu-erosion-v2"],
  "layer_stack": ["base", "imported", "intent", "stamps", "splines", "placed", "frozen"],
  "turned_noise_default": true,
  "version_pins": [
    {"key": "world_def_schema", "value": 2, "const_path": "planet_world_def::toml_io::SCHEMA_VERSION", "spec_ids": ["WDEF-002"]},
    {"key": "world_def_item_schema", "value": 1, "const_path": "planet_world_def::item::ITEM_SCHEMA_VERSION", "spec_ids": ["AUTH-001"]},
    {"key": "world_def_item_points", "value": 2, "const_path": "planet_world_def::item::ITEM_SCHEMA_VERSION_POINTS", "spec_ids": ["AUTH-005"]},
    {"key": "world_def_item_strokes", "value": 3, "const_path": "planet_world_def::item::ITEM_SCHEMA_VERSION_STROKES", "spec_ids": ["AUTH-005"]},
    {"key": "world_def_chain_order_era", "value": 2, "const_path": "planet_world_def::CHAIN_ORDER_ERA", "spec_ids": ["GEN-039", "TEST-075"]},
    {"key": "class_list", "value": 1, "const_path": "planet_generators::classes::CLASS_LIST_VERSION", "spec_ids": ["GEN-093"]},
    {"key": "class_source", "value": 9, "const_path": "planet_generators::classes::CLASS_SOURCE_VERSION", "spec_ids": ["GEN-094", "GEN-140"]},
    {"key": "lithology", "value": 2, "const_path": "planet_generators::lithology::LITHOLOGY_VERSION", "spec_ids": ["GEN-116"]},
    {"key": "uplift", "value": 1, "const_path": "planet_generators::uplift::UPLIFT_VERSION", "spec_ids": ["GEN-123"]},
    {"key": "orography", "value": 1, "const_path": "planet_generators::orography::OROGRAPHY_VERSION", "spec_ids": ["GEN-117"]},
    {"key": "arid_rules", "value": 1, "const_path": "planet_generators::arid::ARID_RULES_VERSION", "spec_ids": ["GEN-128"]},
    {"key": "ice_history", "value": 1, "const_path": "planet_generators::ice::ICE_VERSION", "spec_ids": ["GEN-134"]},
    {"key": "global_bake", "value": 9, "const_path": "planet_generators::global::GLOBAL_VERSION", "spec_ids": ["GEN-013", "GEN-136"]},
    {"key": "reader_bilinear", "value": 1, "const_path": "planet_generators::global::READER_VERSION", "spec_ids": ["GEN-013"]},
    {"key": "reader_c1", "value": 1, "const_path": "planet_generators::global::READER_C1_VERSION", "spec_ids": ["GEN-107"]},
    {"key": "climate", "value": 1, "const_path": "planet_generators::climate::CLIMATE_VERSION", "spec_ids": ["GEN-021"]},
    {"key": "height_climate", "value": 1, "const_path": "planet_generators::climate::HEIGHT_CLIMATE_VERSION", "spec_ids": ["GEN-021"]},
    {"key": "relief_channels", "value": 1, "const_path": "planet_generators::relief_channels::RELIEF_CHANNELS_VERSION", "spec_ids": ["GEN-099"]},
    {"key": "coupled_h0", "value": 1, "const_path": "planet_generators::coupled::COUPLED_VERSION", "spec_ids": ["GEN-040"]},
    {"key": "coupled_lens", "value": 1, "const_path": "planet_generators::coupled::LENS_VERSION", "spec_ids": ["GEN-043"]},
    {"key": "coarse_horizon", "value": 2, "const_path": "planet_generators::coarsehorizon::COARSE_HORIZON_VERSION", "spec_ids": ["STRM-045"]},
    {"key": "runoff", "value": 1, "const_path": "planet_generators::runoff::RUNOFF_VERSION", "spec_ids": ["GEN-117"]},
    {"key": "bake_kernel", "value": 8, "const_path": "planet_generators::bake::BAKE_KERNEL_VERSION", "spec_ids": ["GEN-100", "GEN-173", "GEN-174"]},
    {"key": "pass2_kernel", "value": 10, "const_path": "planet_generators::bake::PASS2_KERNEL_VERSION", "spec_ids": ["GEN-101", "GEN-176"]},
    {"key": "lakes", "value": 1, "const_path": "planet_generators::bake::lakes::LAKES_VERSION", "spec_ids": ["GEN-177"]},
    {"key": "erosion_layer_read", "value": 2, "const_path": "planet_generators::erosion_layer::LAYER_READ_VERSION", "spec_ids": ["GEN-112", "GEN-188"]},
    {"key": "driver_map", "value": 1, "const_path": "planet_generators::drivers::DRIVER_MAP_VERSION", "spec_ids": ["GEN-119"]},
    {"key": "channel_block", "value": 1, "const_path": "planet_generators::drivers::CHANNEL_BLOCK_VERSION", "spec_ids": ["GEN-126"]},
    {"key": "erosion_field_v1", "value": 3, "const_path": "planet_generators::erosion::EROSION_VERSION", "spec_ids": ["GEN-017", "GEN-140"]},
    {"key": "erosion_field_c1_v2", "value": 2, "const_path": "planet_generators::erosion::EROSION_C1_VERSION", "spec_ids": ["GEN-107", "GEN-140"]},
    {"key": "crease_band", "value": 1, "const_path": "planet_generators::erosion::CREASE_BAND_VERSION", "spec_ids": ["GEN-109"]},
    {"key": "pinned_detail", "value": 1, "const_path": "planet_generators::erosion::PINNED_DETAIL_VERSION", "spec_ids": ["GEN-187"]},
    {"key": "turned_noise_default", "value": 1, "const_path": "planet_generators::height::turned_noise()", "spec_ids": ["GEN-140"]},
    {"key": "terrain_field", "value": 1, "const_path": "planet_generators::terrain::TERRAIN_VERSION", "spec_ids": ["GEN-016"]},
    {"key": "reference_generator", "value": 2, "const_path": "planet_generators::height::GENERATOR_VERSION", "spec_ids": ["GEN-001"]},
    {"key": "key_format", "value": 2, "const_path": "planet_generators::height::KEY_FORMAT_VERSION", "spec_ids": ["STRM-003"]},
    {"key": "stamp_stage", "value": 4, "const_path": "planet_generators::stamp::STAMP_STAGE_VERSION", "spec_ids": ["GEN-026"]},
    {"key": "water_surface", "value": 2, "const_path": "planet_generators::water::WATER_VERSION", "spec_ids": ["GEN-023"]},
    {"key": "mesh", "value": 11, "const_path": "planet_generators::mesh::MESH_VERSION", "spec_ids": ["STRM-003"]},
    {"key": "stage_key", "value": 1, "const_path": "planet_generators::stage::STAGE_KEY_VERSION", "spec_ids": ["STRM-011"]},
    {"key": "preview_world", "value": 1, "const_path": "planet_generators::preview::PREVIEW_VERSION", "spec_ids": ["GEN-103"]},
    {"key": "bake_preview", "value": 1, "const_path": "planet_generators::bake::preview::PREVIEW_VERSION", "spec_ids": ["GEN-103"]}
  ],
  "stages": [
    {
      "id": "world-definition",
      "title": "World Definition & Authored Layers",
      "scale": "global-input",
      "summary": "Seed, body radius, sea params, `world.height_field`, and spatial-indexed authored items ordered by ADR 0007 layer stack.",
      "reads": [],
      "outputs": ["WorldDefinition node hashes", "GenContext read records", "per-layer ItemSpec footprint index"],
      "version_pins": ["world_def_schema", "world_def_item_schema", "world_def_chain_order_era"],
      "active_when": "always",
      "edit_preview_level": "L0",
      "spec_ids": ["WDEF-002", "WDEF-004", "AUTH-001"],
      "preview": null
    },
    {
      "id": "continents-and-plates",
      "title": "Continents, Plate Mask & Relief Classes",
      "scale": "global-input",
      "summary": "Default `ClassSource` continents, active/passive plate margins, base elevation `e0`, 8-class weights, and untapered relief driver `k`.",
      "reads": ["world-definition"],
      "outputs": ["ClassSource (e0, land_depth, plate terms)", "ClassLattice (256 cells/face, weights, k)"],
      "version_pins": ["class_list", "class_source", "preview_world"],
      "active_when": "height_field != cpu-ref-height-v2 && global bake source == class",
      "edit_preview_level": "L0",
      "spec_ids": ["GEN-093", "GEN-094", "GEN-095", "GEN-103", "GEN-104"],
      "preview": {"command_template": "cargo xtask preview world --seed {seed} --out {out_dir}", "files": ["land-sea.png", "elevation.png", "elevation-today.png", "elevation-compare.png", "plate-mask.png", "plateau-backarc.png", "classes-argmax.png", "classes-blend.png", "k.png", "report.txt"], "optional_files": []}
    },
    {
      "id": "shelf-bathymetry",
      "title": "Continental Shelf & Ocean Bathymetry",
      "scale": "global-input",
      "summary": "Coast-distance lattice and smooth passive/active margin shelf-slope-abyssal profile merged into `ClassSource` sea floor.",
      "reads": ["world-definition", "continents-and-plates"],
      "outputs": ["CoastLattice distance-to-coast", "ShelfProfile ocean-floor elevation"],
      "version_pins": ["class_source", "global_bake"],
      "active_when": "height_field != cpu-ref-height-v2 && global bake source == class",
      "edit_preview_level": "L0",
      "spec_ids": ["GEN-118", "GEN-136"],
      "preview": {"command_template": "cargo run --release -p planet -- generate --shelf-preview {out_dir} --seed {seed}", "files": ["bathymetry.png", "shelf.txt"], "optional_files": ["region_passive_2km.png", "region_passive_10km.png", "region_active_2km.png", "region_active_10km.png"]}
    },
    {
      "id": "lithology",
      "title": "Analytic Lithology & Rock Strata",
      "scale": "global-input",
      "summary": "Unstored `H(d)` hardness, tilted/folded stratigraphic bands `K(d, z)`, caprock flags, and soluble carbonate gates for the erosion carve.",
      "reads": ["world-definition", "continents-and-plates"],
      "outputs": ["ProvinceLattice", "Column::at(z) erodibility K, caprock, soluble"],
      "version_pins": ["lithology"],
      "active_when": "regional/global erosion bake",
      "edit_preview_level": "L0",
      "spec_ids": ["GEN-116"],
      "preview": {"command_template": "cargo run --release -p planet -- generate --lithology-preview {out_dir} --seed {seed}", "files": ["hardness.png", "strata_surface.png", "strata_200m_below.png", "soluble.png", "section.png", "lithology.txt"], "optional_files": []}
    },
    {
      "id": "tectonic-uplift",
      "title": "Analytic Tectonic Uplift",
      "scale": "global-input",
      "summary": "Unstored `U(d)` uplift field driven by craton, belt/arc coast, back-arc, and rift province terms.",
      "reads": ["world-definition", "lithology"],
      "outputs": ["Uplift::at(provinces, d)"],
      "version_pins": ["uplift"],
      "active_when": "regional/global erosion bake",
      "edit_preview_level": "L0",
      "spec_ids": ["GEN-123", "GEN-125"],
      "preview": {"command_template": "cargo run --release -p planet -- generate --uplift-preview {out_dir} --seed {seed}", "files": ["uplift.png", "steepness.png", "section.png", "uplift.txt"], "optional_files": []}
    },
    {
      "id": "orographic-climate",
      "title": "Two-Season Orographic Climate",
      "scale": "global-input",
      "summary": "Jacobi vapour/cloud advection over `e0` for northern summer and winter winds giving precipitation, temperature, aridity, and runoff.",
      "reads": ["world-definition", "continents-and-plates", "lithology"],
      "outputs": ["Orography 512x512 lattice (precipitation, temperature, aridity, seasonality)"],
      "version_pins": ["orography", "runoff"],
      "active_when": "height_field != cpu-ref-height-v2 && global bake source == class",
      "edit_preview_level": "L0",
      "spec_ids": ["GEN-117", "GEN-130"],
      "preview": {"command_template": "cargo run --release -p planet -- generate --climate-preview {out_dir} --seed {seed}", "files": ["precipitation_annual_wind.png", "precipitation_two_seasons.png", "precipitation_difference.png", "aridity.png", "seasonality.png", "wind_northern_summer.png", "wind_northern_winter.png", "regions.png", "orography.txt"], "optional_files": []}
    },
    {
      "id": "arid-class-rules",
      "title": "Arid Class Rules (Badlands & Sand Sea)",
      "scale": "global-input",
      "summary": "Read-time class weight remix for badlands and sand seas from aridity, lithology hardness, base elevation, and sediment supply.",
      "reads": ["continents-and-plates", "lithology", "orographic-climate"],
      "outputs": ["AridRules blended class weights", "tapered/blended k"],
      "version_pins": ["arid_rules", "relief_channels"],
      "active_when": "height_field != cpu-ref-height-v2 && global bake source == class",
      "edit_preview_level": "L0",
      "spec_ids": ["GEN-128"],
      "preview": {"command_template": "cargo run --release -p planet -- generate --arid-preview {out_dir} --seed {seed}", "files": ["classes_after.png", "classes_before.png", "badlands_weight.png", "sand_sea_weight.png", "arid.txt"], "optional_files": []}
    },
    {
      "id": "ice-history",
      "title": "Glacial Maximum Ice History",
      "scale": "global-input",
      "summary": "LGM equilibrium line altitude (ELA) and glaciated cover mask derived analytically from the two-season climate lattice.",
      "reads": ["orographic-climate"],
      "outputs": ["IceHistory (ela_m, cover)"],
      "version_pins": ["ice_history"],
      "active_when": "regional/global ice and fjord stages",
      "edit_preview_level": "L0",
      "spec_ids": ["GEN-134"],
      "preview": {"command_template": "cargo run --release -p planet -- generate --ice-preview {out_dir} --seed {seed}", "files": ["ice_extent.png", "ela.png", "ice.txt"], "optional_files": []}
    },
    {
      "id": "global-bake-lattice",
      "title": "Global-Coarse Bake Lattice & Channels",
      "scale": "global-bake",
      "summary": "Block-stored cube-sphere lattice (production 16,384 cells/face): `elevation_m`, `continent`, climate, ocean mask, water summary, relief `k`/`m`.",
      "reads": ["world-definition", "continents-and-plates", "shelf-bathymetry", "orographic-climate", "arid-class-rules"],
      "outputs": ["GlobalGrid (cpu-global-coarse-v1)", "OceanLattice", "WaterSummary", "ReliefChannels (k, m)"],
      "version_pins": ["global_bake", "reader_bilinear", "reader_c1", "climate", "relief_channels", "stage_key"],
      "active_when": "height_field != cpu-ref-height-v2",
      "edit_preview_level": "L1",
      "spec_ids": ["GEN-013", "GEN-099", "GEN-115", "STRM-012", "STRM-073"],
      "preview": null
    },
    {
      "id": "coupled-h0",
      "title": "Coupled H0 Drainage & Lake Graph",
      "scale": "global-bake",
      "summary": "Single-thread global D8 priority flood, drainage area accumulation, implicit stream-power step, lake basins, and coarse horizon.",
      "reads": ["global-bake-lattice", "lithology", "tectonic-uplift"],
      "outputs": ["CoupledMaps (H0 drainage, lakes)", "CoarseHorizon", "CoupledLens debug climate view"],
      "version_pins": ["coupled_h0", "coupled_lens", "coarse_horizon"],
      "active_when": "coupled run or coarse horizon enabled on stored bake",
      "edit_preview_level": "L1",
      "spec_ids": ["GEN-040", "GEN-043", "STRM-045", "STRM-051"],
      "preview": null
    },
    {
      "id": "erosion-bake-chain",
      "title": "Erosion & River-Graph Bake Chain (H1..K7)",
      "scale": "region-bake",
      "summary": "Pass-1 routing/carve and pass-2 fine tile carve (thermal, deposition, pit-spreading, K7 river burn) writing kind-13 delta tiles and driver channels.",
      "reads": ["global-bake-lattice", "coupled-h0", "lithology", "tectonic-uplift", "orographic-climate", "ice-history"],
      "outputs": ["ErosionLayer kind-13 delta tiles (B + L)", "ChannelSource (soil_m, area_log2_cells, fill_m, erosion_m)", "docs/stages/manifest.txt"],
      "version_pins": ["bake_kernel", "pass2_kernel", "lakes", "erosion_layer_read", "pinned_detail", "bake_preview"],
      "active_when": "erosion_layer == true (--erosion on)",
      "edit_preview_level": "L2",
      "spec_ids": ["GEN-100", "GEN-101", "GEN-112", "GEN-126", "GEN-187", "BUILD-047", "BUILD-060", "BUILD-061"],
      "preview": {"command_template": "cargo xtask stages", "files": ["docs/stages/manifest.txt", "docs/stages/pipeline.json"], "optional_files": ["target/review/stages/ci/r1h.png", "target/review/stages/ci/m1.png"]}
    },
    {
      "id": "runtime-base-field",
      "title": "Runtime Base HeightField Selection",
      "scale": "tile-runtime",
      "summary": "Resolves `world.height_field` plus `--erosion` / `--channels` runtime switches into `ErosionField`, `TerrainField`, or `Reference`.",
      "reads": ["world-definition", "global-bake-lattice", "erosion-bake-chain"],
      "outputs": ["Base HeightField (height, height_bounds, climate, optional driver_channels)"],
      "version_pins": ["erosion_field_v1", "erosion_field_c1_v2", "crease_band", "pinned_detail", "turned_noise_default", "terrain_field", "reference_generator"],
      "active_when": "always",
      "edit_preview_level": "L3",
      "spec_ids": ["GEN-016", "GEN-017", "GEN-018", "GEN-107", "GEN-109", "GEN-112", "GEN-140"],
      "preview": null
    },
    {
      "id": "authored-stamp-stages",
      "title": "Authored Stamp Stage Stack",
      "scale": "tile-runtime",
      "summary": "Stacks one `StampStage` per populated layer in ADR 0007 order over the base field, passing untouched tiles through (`STRM-029`).",
      "reads": ["world-definition", "runtime-base-field"],
      "outputs": ["Chained HeightField (upstream() -> below, stage_params() -> (layer, stack_index))"],
      "version_pins": ["stamp_stage", "world_def_chain_order_era"],
      "active_when": "def.stamp_layers(PLANET) is non-empty",
      "edit_preview_level": "L3",
      "spec_ids": ["GEN-026", "GEN-027", "GEN-028", "GEN-030", "STRM-027", "STRM-029"],
      "preview": null
    },
    {
      "id": "water-cull-and-tile-plan",
      "title": "Water Bound, Drivers & Tile Plan",
      "scale": "tile-runtime",
      "summary": "Optional `WaterBounded` frustum cull wrapper, `WaterField` producers, driver/channel block encoding, and compact tile mesh output.",
      "reads": ["authored-stamp-stages", "global-bake-lattice", "erosion-bake-chain"],
      "outputs": ["WaterBounded::water_cull_level", "WaterField", "CompactTile (heights, normals, driver, channel, mesh)"],
      "version_pins": ["water_surface", "driver_map", "channel_block", "mesh", "key_format"],
      "active_when": "always (water_cull_level active when bound_water == true)",
      "edit_preview_level": "L3",
      "spec_ids": ["GEN-023", "GEN-025", "GEN-074", "GEN-119", "STRM-003"],
      "preview": null
    }
  ],
  "switch_matrix": [
    {"height_field": "cpu-erosion-v1", "erosion_layer": false, "relief_lattice": false, "channels": false, "implementation_id": "cpu-erosion-v1", "version": 3, "needs_bake": true},
    {"height_field": "cpu-erosion-v1", "erosion_layer": true, "relief_lattice": false, "channels": false, "implementation_id": "cpu-erosion-v1+band+layer", "version": 3, "needs_bake": true},
    {"height_field": "cpu-erosion-v1", "erosion_layer": true, "relief_lattice": true, "channels": false, "implementation_id": "cpu-erosion-v1+relief+band+layer", "version": 3, "needs_bake": true},
    {"height_field": "cpu-erosion-v1", "erosion_layer": true, "relief_lattice": false, "channels": true, "implementation_id": "cpu-erosion-v1+band+layer", "version": 3, "needs_bake": true},
    {"height_field": "cpu-erosion-v1", "erosion_layer": true, "relief_lattice": true, "channels": true, "implementation_id": "cpu-erosion-v1+relief+band+layer", "version": 3, "needs_bake": true},
    {"height_field": "cpu-terrain-v1", "erosion_layer": false, "relief_lattice": false, "channels": false, "implementation_id": "cpu-terrain-v1", "version": 1, "needs_bake": true},
    {"height_field": "cpu-ref-height-v2", "erosion_layer": false, "relief_lattice": false, "channels": false, "implementation_id": "cpu-ref-height-v2", "version": 2, "needs_bake": false},
    {"height_field": "cpu-erosion-v2", "erosion_layer": false, "relief_lattice": false, "channels": false, "implementation_id": "cpu-erosion-v2", "version": 2, "needs_bake": true},
    {"height_field": "cpu-erosion-v2", "erosion_layer": true, "relief_lattice": false, "channels": false, "implementation_id": "cpu-erosion-v2+band+layer", "version": 2, "needs_bake": true},
    {"height_field": "cpu-erosion-v2", "erosion_layer": true, "relief_lattice": true, "channels": false, "implementation_id": "cpu-erosion-v2+relief+band+layer", "version": 2, "needs_bake": true},
    {"height_field": "cpu-erosion-v2", "erosion_layer": true, "relief_lattice": false, "channels": true, "implementation_id": "cpu-erosion-v2+band+layer", "version": 2, "needs_bake": true},
    {"height_field": "cpu-erosion-v2", "erosion_layer": true, "relief_lattice": true, "channels": true, "implementation_id": "cpu-erosion-v2+relief+band+layer", "version": 2, "needs_bake": true}
  ]
}
