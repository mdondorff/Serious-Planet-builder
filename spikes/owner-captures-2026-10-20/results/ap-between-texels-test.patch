+#[test]
+#[ignore]
+fn spike20_error_split() {
+    let (atm, luts) = earth();
+    let land = [0.010, 0.012, 0.006];
+    for h in [20_000.0f64, 60_000.0, 97_500.0] {
+        let f = frame_at(atm, h, 0.7);
+        let mut table = vec![[0.0f64; 4]; AP_W * AP_H * AP_D];
+        for iz in 0..AP_D { for iy in 0..AP_H { for ix in 0..AP_W { table[(iz * AP_H + iy) * AP_W + ix] = f.ap_texel(atm, luts, ix, iy, iz); } } }
+        let err_at = |b: f64| -> Option<f64> {
+            let v = [f.fwd[0] + f.upv[0] * b, f.fwd[1] + f.upv[1] * b, f.fwd[2] + f.upv[2] * b];
+            let l = libm::sqrt(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]);
+            let dir = [v[0] / l, v[1] / l, v[2] / l];
+            let (mu, cos_vs) = f.view_cosines(dir);
+            let t_g = distance_to_ground(f.r * mu, f.c)?;
+            let o = RayOrigin { h: f.h, r: f.r, c: f.c, rmu: f.r * mu, r_musun: f.r * f.mu_sun };
+            let limit = distance_to_top(f.r * mu, f.c_top);
+            let m = atm.march(luts, &o, cos_vs, t_g.min(limit), StepLayout::Uniform(2048), Scatter::Physical { cos_gamma: cos_vs });
+            let ap = f.ap_lookup(&table, [0.5, (1.0 - b) / 2.0], t_g);
+            let tm = (m.transmittance[0] + m.transmittance[1] + m.transmittance[2]) / 3.0;
+            Some((0..3).map(|c| ((land[c] * ap[3] + ap[c]) - (land[c] * tm + m.radiance[c])).abs() / (land[c] * tm + m.radiance[c]).abs().max(1e-6)).fold(0.0, f64::max))
+        };
+        // rows exactly (y exact, z interpolated) and halfway between rows (y interpolated too)
+        let (mut at_rows, mut between) = (0.0f64, 0.0f64);
+        for iy in 0..AP_H - 1 {
+            let b0 = 1.0 - 2.0 * (iy as f64 + 0.5) / AP_H as f64;
+            let b1 = 1.0 - 2.0 * (iy as f64 + 1.5) / AP_H as f64;
+            if let Some(e) = err_at(b0) { at_rows = at_rows.max(e); }
+            if let Some(e) = err_at(0.5 * (b0 + b1)) { between = between.max(e); }
+        }
+        eprintln!("h {h}: worst error at row centres (distance interpolation only) {:.1} %, between rows {:.1} %", at_rows * 100.0, between * 100.0);
+    }
+}
