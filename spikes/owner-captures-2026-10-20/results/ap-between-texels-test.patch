+#[test]
+#[ignore]
+fn spike20_orbit_error() {
+    let (atm, luts) = earth();
+    let land = [0.010, 0.012, 0.006];
+    for h in [101_000.0f64, 114_000.0, 200_000.0, 1_000_000.0] {
+        let f = frame_at(atm, h, 0.7);
+        let (big_r, top) = (atm.radius_m, atm.top_m());
+        let (mut worst, mut at) = (0.0f64, String::new());
+        let (mut changes, mut prev) = (0, 0.0f64);
+        for k in 0..800 {
+            let b = 0.95 - 1.9 * f64::from(k) / 799.0;
+            let v = [f.fwd[0] + f.upv[0] * b, f.fwd[1] + f.upv[1] * b, f.fwd[2] + f.upv[2] * b];
+            let l = libm::sqrt(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]);
+            let dir = [v[0] / l, v[1] / l, v[2] / l];
+            let (mu, cos_vs) = f.view_cosines(dir);
+            let Some(t_g) = distance_to_ground(f.r * mu, f.c) else { continue };
+            let got = f.orbit_ray_cosines(atm, luts, mu, cos_vs, Some(t_g));
+            if !got.enters { continue; }
+            // the converged version of the same march
+            let rmu = f.r * mu;
+            let sq = libm::sqrt((rmu - f.q_top) * (rmu + f.q_top));
+            let t0 = f.c_top / (-rmu + sq);
+            let o = RayOrigin { h: top, r: big_r + top, c: atm.rho_top * atm.rho_top, rmu: -sq, r_musun: f.r * f.mu_sun + t0 * cos_vs };
+            let m = atm.march(luts, &o, cos_vs, t_g - t0, StepLayout::Uniform(4096), Scatter::Physical { cos_gamma: cos_vs });
+            let mut err = 0.0f64;
+            for c in 0..3 {
+                let a = land[c] * got.transmittance[c] + got.radiance[c];
+                let e = land[c] * m.transmittance[c] + m.radiance[c];
+                err = err.max((a - e).abs() / e.abs().max(1e-6));
+            }
+            if err > worst { worst = err; at = format!("b {b:.3} ground {:.0} km", t_g / 1000.0); }
+            if (err - prev) * prev < 0.0 && err > 0.005 { changes += 1; }
+            prev = err;
+        }
+        eprintln!("h {h}: orbit march (40 steps) worst {:.2} % at {at}; slope changes {changes}", worst * 100.0);
+    }
+}
