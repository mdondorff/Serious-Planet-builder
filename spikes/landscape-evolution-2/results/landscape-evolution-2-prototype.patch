+/// A window of a face of the (finer) cube sphere; its border cells are outlets.
+struct Patch {
+    n_fine: usize,
+    face: usize,
+    i0: usize,
+    j0: usize,
+    w: usize,
+    hh: usize,
+    area: Vec<f32>,
+}
+impl Patch {
