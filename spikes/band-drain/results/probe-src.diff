+/// SPIKE-110 probe (spikes lane, never merged): the raw noise `n` of each hill octave (the signal [`hill_octave_signals`] is `(1 - |n|)^2` of it).
+pub(crate) fn hill_octave_noise(seed: u64, t: &Terrain, turned: bool) -> [f64; HILL_BAND_OCTAVES as usize] {
+    let mut out = [0.0; HILL_BAND_OCTAVES as usize];
+    let mut freq = HILL_BAND_FREQ;
+    for (o, s) in out.iter_mut().enumerate() {
+        *s = layer_noise_t(turned, seed, LAYER_HILL, o as u32, t.warped * freq);
+        freq *= 2.0;
+    }
+    out
+}
+
+/// SPIKE-110 probe: the hill band's raw noise of octave `o` at the point `p` (already scaled by the octave's frequency).
+pub(crate) fn hill_noise_at(turned: bool, seed: u64, o: u32, p: Vec3) -> f64 {
+    layer_noise_t(turned, seed, LAYER_HILL, o, p)
+}
