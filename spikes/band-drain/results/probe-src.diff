+/// Sets the bump form: the floor fraction `q` (the quantile of `|n|` below which the floor lies: `c`), a gain on the band's amplitude (1 = the standard deviation of the plain band), and `elong` samples of elongation (1 = none).
+/// Calibrates `c`, the gains and the centre from 150,000 deterministic directions (the noise statistics do not depend on the seed).
+pub fn set_probe_bump(q: f64, gain: f64, elong: usize) -> BumpParams {
+    let seed = 1u64;
+    let turned = turned_noise();
+    let mut s: u64 = 0x9E37_79B9_7F4A_7C15;
+    let mut next = || {
+        s = s.wrapping_mul(6_364_136_223_846_793_005).wrapping_add(1_442_695_040_888_963_407);
+        ((s >> 11) as f64) / ((1u64 << 53) as f64) * 2.0 - 1.0
+    };
+    let mut dirs: Vec<Vec3> = Vec::new();
+    while dirs.len() < 150_000 {
+        let v = Vec3::new(next(), next(), next());
+        let l = v.length();
+        if l > 0.1 && l <= 1.0 {
+            dirs.push(v * (1.0 / l));
+        }
     }
+    let terr: Vec<Terrain> = dirs.iter().map(|&d| terrain(seed, d)).collect();
+    let mut absn: Vec<f64> = terr.iter().map(|t| libm::fabs(crate::global::hill_octave_noise(seed, t, turned)[0])).collect();
+    absn.sort_by(f64::total_cmp);
+    let c = absn[((absn.len() - 1) as f64 * q) as usize];
+    let top = absn[((absn.len() - 1) as f64 * 0.999) as usize];
+    let mut p = BumpParams { c, top, g_hill: 1.0, g_ridged: 1.0, centre: 0.0, elong, gain: 1.0 };
+    let stat = |v: &[f64]| {
+        let m = v.iter().sum::<f64>() / v.len() as f64;
+        (m, (v.iter().map(|x| (x - m) * (x - m)).sum::<f64>() / v.len() as f64).sqrt())
+    };
+    let hb: Vec<f64> = terr.iter().map(|t| hill_octaves_with(seed, t, turned)).collect();
+    let rb: Vec<f64> = terr.iter().map(|t| ridged_octaves(seed, t, turned)).collect();
+    let axis = Vec3::new(0.267_261_241_912_424_4, 0.534_522_483_824_848_8, 0.801_783_725_737_273_2);
+    let tang = |d: Vec3| if elong > 1 { Some(d.cross(axis).normalized()) } else { None };
+    let hn: Vec<f64> = terr.iter().zip(&dirs).map(|(t, &d)| hill_bump_noise(seed, t, turned, &p, tang(d))).collect();
+    let rn: Vec<f64> = terr.iter().zip(&dirs).map(|(t, &d)| ridged_bump_noise(seed, t, turned, &p, tang(d))).collect();
+    let ((_, sh_b), (_, sh_n)) = (stat(&hb), stat(&hn));
+    let ((_, sr_b), (_, sr_n)) = (stat(&rb), stat(&rn));
+    p.g_hill = sh_b / sh_n;
+    p.g_ridged = sr_b / sr_n;
+    p.centre = stat(&rn).0 * p.g_ridged;
+    p.gain = gain;
+    eprintln!(
+        "bump: floor fraction {q}: c {c:.4} top {top:.4}; hill band mean {:.3} sd {sh_b:.3}, bump sd {sh_n:.3} -> g_hill {:.3}; ridged mean {:.3} sd {sr_b:.3}, bump sd {sr_n:.3} -> g_ridged {:.3}, centre {:.3}",
+        stat(&hb).0,
+        p.g_hill,
+        stat(&rb).0,
+        p.g_ridged,
+        p.centre
+    );
+    *BUMP.write().unwrap() = Some(p);
+    p
 }
