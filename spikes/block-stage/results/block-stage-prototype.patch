+//! SPIKE-34 prototype: a block field over a base field (ADR 0077). Never merged.
+//!
+//! A [`BlockField`] is a [`HeightField`] that adds, inside every block of a fixed grid (a tile of `level` on a cube face), the result of a
+//! per-block run: a stand-in for any regional process (erosion, drainage) that is iterative, reads the base field over the block plus a halo
+//! and keeps the halo's outer border fixed. A block that is not ready is the base field (the coarse stand-in) and is recorded as requested;
+//! `height` never waits (CON-22). The run is [`compute_block`]; its cost in the engine is the method's, here a parameter of the simulation.
+
+use crate::height::HeightField;
+use planet_core::cube::{direction_to_face, face_to_direction, TangentWarp};
+use planet_core::hash::hash_u64s;
+use planet_core::{Face, TileId, Vec3};
+use std::collections::{BTreeSet, HashMap};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Mutex, RwLock};
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct BlockParams {
+    /// The level of the tile that is the block (11: about 4.9 km, 10: 9.8 km, 9: 19.6 km at Earth's radius).
+    pub level: u8,
+    /// Grid spacing of a block's run in metres (the nominal one: the grid is whole cells of the block).
+    pub cell_m: f64,
+    /// Halo in cells of the run's grid, on every side.
+    pub halo_cells: usize,
+    /// Steps of the stand-in process (each a 3x3 relaxation: its reach is one cell per step).
+    pub steps: u32,
+    /// Amplitude of the stand-in's initial relief in metres.
+    pub amp_m: f64,
+    pub radius_m: f64,
+}
+
+impl BlockParams {
+    /// Block edge at the face centre in metres.
+    pub fn block_edge_m(&self) -> f64 {
+        self.radius_m * core::f64::consts::FRAC_PI_2 / f64::from(1u32 << self.level)
+    }
+
+    /// The first tile level whose vertex spacing (`tile_cells` cells per edge) is at most twice the block's cell size: a coarser tile cannot show
+    /// the block's detail (Nyquist), so it is drawn from the base field whatever the block holds and never waits for it.
+    pub fn apply_level(&self, tile_cells: u32) -> u8 {
+        let mut level = self.level;
+        while self.block_edge_m() / f64::from(1u32 << (level - self.level)) / f64::from(tile_cells) > 2.0 * self.cell_m {
+            level += 1;
+        }
+        level
+    }
+
+    /// Interior cells per block edge: whole cells, a power of two is not needed.
+    pub fn cells(&self) -> usize {
+        (self.block_edge_m() / self.cell_m).round().max(2.0) as usize
+    }
+
+    fn word(&self) -> u64 {
+        hash_u64s(
+            0x626c_6f63,
+            &[
+                u64::from(self.level),
+                self.cell_m.to_bits(),
+                self.halo_cells as u64,
+                u64::from(self.steps),
+                self.amp_m.to_bits(),
+                self.radius_m.to_bits(),
+            ],
+        )
+    }
+}
+
+/// The result of one block's run: the height change against the base on the interior nodes, `(cells + 1)^2`, row-major with `s` fastest.
+pub struct BlockGrid {
+    pub id: TileId,
+    pub cells: usize,
+    pub delta: Vec<f32>,
+    pub min: f32,
+    pub max: f32,
+    pub compute_ms: f64,
+    pub content: u64,
+}
+
+impl BlockGrid {
+    pub fn bytes(&self) -> usize {
+        self.delta.len() * 4 + 64
+    }
+
+    /// Bilinear sample at the fractions `(fs, ft)` of the block.
+    pub fn sample(&self, fs: f64, ft: f64) -> f64 {
+        let n = self.cells;
+        let (x, y) = ((fs * n as f64).clamp(0.0, n as f64), (ft * n as f64).clamp(0.0, n as f64));
+        let (i, j) = ((x.floor() as usize).min(n - 1), (y.floor() as usize).min(n - 1));
+        let (wx, wy) = (x - i as f64, y - j as f64);
+        let at = |a: usize, b: usize| f64::from(self.delta[b * (n + 1) + a]);
+        at(i, j) * (1.0 - wx) * (1.0 - wy) + at(i + 1, j) * wx * (1.0 - wy) + at(i, j + 1) * (1.0 - wx) * wy + at(i + 1, j + 1) * wx * wy
+    }
+}
+
+fn lattice(seed: u64, x: i64, y: i64, z: i64) -> f64 {
+    let h = hash_u64s(seed, &[x as u64, y as u64, z as u64]);
+    (h >> 11) as f64 * (1.0 / (1u64 << 53) as f64) * 2.0 - 1.0
+}
+
+fn smooth(t: f64) -> f64 {
+    t * t * (3.0 - 2.0 * t)
+}
+
+/// Value noise in [-1, 1] on the lattice of `wavelength_m` over a position in metres.
+fn noise3(seed: u64, p: Vec3, wavelength_m: f64) -> f64 {
+    let q = p * (1.0 / wavelength_m);
+    let (fx, fy, fz) = (libm::floor(q.x), libm::floor(q.y), libm::floor(q.z));
+    let (tx, ty, tz) = (smooth(q.x - fx), smooth(q.y - fy), smooth(q.z - fz));
+    let (ix, iy, iz) = (fx as i64, fy as i64, fz as i64);
+    let mut acc = 0.0;
+    for dz in 0..2 {
+        for dy in 0..2 {
+            for dx in 0..2 {
+                let w = (if dx == 1 { tx } else { 1.0 - tx }) * (if dy == 1 { ty } else { 1.0 - ty }) * (if dz == 1 { tz } else { 1.0 - tz });
+                acc += w * lattice(seed, ix + dx, iy + dy, iz + dz);
+            }
+        }
+    }
+    acc
+}
+
+/// The stand-in's initial relief at a position: ridged noise of 800 m, 200 m and 50 m, scaled by the amplitude.
+fn relief(p: Vec3, amp_m: f64) -> f64 {
+    let mut s = 0.0;
+    for (k, w) in [(800.0, 1.0), (200.0, 0.5), (50.0, 0.25)] {
+        s += w * (1.0 - 2.0 * libm::fabs(noise3(0x5245_4c49, p, k)));
+    }
+    amp_m * s / 1.75
+}
+
+/// The block's face coordinates: `(face, s0, ds, t0, dt)`.
+fn block_frame(id: TileId) -> (Face, f64, f64, f64, f64) {
+    let (s0, s1, t0, t1) = id.bounds();
+    (id.face(), s0, s1 - s0, t0, t1 - t0)
+}
+
+/// Run the stand-in process over block `id` and its halo: initial heights are the base plus [`relief`]; `steps` relaxations of
+/// `h <- h + 0.5 (mean of the four neighbours - h)` with the outer border of the halo fixed; the result is the change against the base on the
+/// interior nodes. Deterministic: a fixed order, no threads, `libm` only. With `halo_cells >= steps` a node's value does not depend on
+/// where the halo ends, so the borders of neighbouring blocks agree bit for bit; with a smaller halo they differ.
+pub fn compute_block(base: &dyn HeightField, p: &BlockParams, id: TileId) -> BlockGrid {
+    let started = std::time::Instant::now();
+    let n = p.cells();
+    let h = p.halo_cells;
+    let w = n + 1 + 2 * h;
+    let (face, s0, ds, t0, dt) = block_frame(id);
+    let mut base_h = vec![0.0f64; w * w];
+    let mut cur = vec![0.0f64; w * w];
+    for b in 0..w {
+        for a in 0..w {
+            let (i, j) = (a as f64 - h as f64, b as f64 - h as f64);
+            let dir = face_to_direction(&TangentWarp, face, s0 + ds * i / n as f64, t0 + dt * j / n as f64);
+            let bh = base.height(dir);
+            base_h[b * w + a] = bh;
+            cur[b * w + a] = bh + relief(dir * p.radius_m, p.amp_m);
+        }
+    }
+    let mut next = cur.clone();
+    for _ in 0..p.steps {
+        for b in 1..w - 1 {
+            for a in 1..w - 1 {
+                let m = 0.25 * (cur[b * w + a - 1] + cur[b * w + a + 1] + cur[(b - 1) * w + a] + cur[(b + 1) * w + a]);
+                next[b * w + a] = cur[b * w + a] + 0.5 * (m - cur[b * w + a]);
+            }
+        }
+        std::mem::swap(&mut cur, &mut next);
+    }
+    let mut delta = Vec::with_capacity((n + 1) * (n + 1));
+    let (mut lo, mut hi, mut content) = (f32::INFINITY, f32::NEG_INFINITY, 0u64);
+    for b in 0..=n {
+        for a in 0..=n {
+            let k = (b + h) * w + a + h;
+            let d = (cur[k] - base_h[k]) as f32;
+            lo = lo.min(d);
+            hi = hi.max(d);
+            content = hash_u64s(content ^ 0x6772_6964, &[u64::from(d.to_bits())]);
+            delta.push(d);
+        }
+    }
+    BlockGrid { id, cells: n, delta, min: lo, max: hi, compute_ms: started.elapsed().as_secs_f64() * 1000.0, content }
+}
+
+/// The block of a direction and the fractions of the direction inside it.
+pub fn locate(dir: Vec3, level: u8) -> (TileId, f64, f64) {
+    let id = TileId::from_direction(&TangentWarp, dir, level);
+    let (_, s, t) = direction_to_face(&TangentWarp, dir);
+    let (_, s0, ds, t0, dt) = block_frame(id);
+    (id, (s - s0) / ds, (t - t0) / dt)
+}
+
+pub struct BlockField<'a> {
+    base: Box<dyn HeightField + 'a>,
+    pub params: BlockParams,
+    ready: RwLock<HashMap<TileId, std::sync::Arc<BlockGrid>>>,
+    requested: Mutex<BTreeSet<TileId>>,
+    pub calls: AtomicU64,
+    pub coarse_calls: AtomicU64,
+    inputs: u64,
+}
+
+impl<'a> BlockField<'a> {
+    pub fn new(base: Box<dyn HeightField + 'a>, params: BlockParams) -> Self {
+        let inputs = hash_u64s(0x626c_6b66, &[base.inputs_hash(), params.word()]);
+        Self { base, params, ready: RwLock::default(), requested: Mutex::default(), calls: AtomicU64::new(0), coarse_calls: AtomicU64::new(0), inputs }
+    }
+
+    pub fn base(&self) -> &dyn HeightField {
+        self.base.as_ref()
+    }
+
+    pub fn insert(&self, g: BlockGrid) {
+        self.ready.write().expect("blocks").insert(g.id, std::sync::Arc::new(g));
+    }
+
+    pub fn remove(&self, id: TileId) -> bool {
+        self.ready.write().expect("blocks").remove(&id).is_some()
+    }
+
+    pub fn get(&self, id: TileId) -> Option<std::sync::Arc<BlockGrid>> {
+        self.ready.read().expect("blocks").get(&id).cloned()
+    }
+
+    pub fn ready_ids(&self) -> Vec<TileId> {
+        self.ready.read().expect("blocks").keys().copied().collect()
+    }
+
+    /// The blocks asked for since the last call (a stand-in was drawn for them).
+    pub fn take_requests(&self) -> Vec<TileId> {
+        std::mem::take(&mut *self.requested.lock().expect("requests")).into_iter().collect()
+    }
+}
+
+impl HeightField for BlockField<'_> {
+    fn height(&self, dir: Vec3) -> f64 {
+        self.calls.fetch_add(1, Ordering::Relaxed);
+        let b = self.base.height(dir);
+        let (id, fs, ft) = locate(dir, self.params.level);
+        match self.ready.read().expect("blocks").get(&id) {
+            Some(g) => b + g.sample(fs, ft),
+            None => {
+                self.coarse_calls.fetch_add(1, Ordering::Relaxed);
+                self.requested.lock().expect("requests").insert(id);
+                b
+            }
+        }
+    }
+
+    fn seed(&self) -> u64 {
+        self.base.seed()
+    }
+
+    fn implementation_id(&self) -> &'static str {
+        "spike-block-v0"
+    }
+
+    fn version(&self) -> u32 {
+        1
+    }
+
+    fn max_abs_height_m(&self) -> f64 {
+        self.base.max_abs_height_m() + 2.0 * self.params.amp_m
+    }
+
+    fn inputs_hash(&self) -> u64 {
+        self.inputs
+    }
+
+    /// The key of a tile: the base's, chained with the block results the tile reads (none for a tile coarser than the block grid: it is the
+    /// base's tile, whatever the blocks hold; a block not ready is its own word, so a stand-in tile never has the key of an exact one).
+    fn inputs_hash_for(&self, tile: TileId, map: &dyn planet_core::cube::FaceMapping) -> u64 {
+        let base = self.base.inputs_hash_for(tile, map);
+        if tile.level() < self.params.level {
+            return base;
+        }
+        let mut anc = tile;
+        while anc.level() > self.params.level {
+            anc = anc.parent().expect("a parent");
+        }
+        let word = self.get(anc).map_or(0, |g| g.content | 1);
+        hash_u64s(self.inputs, &[base, word, anc.raw()])
+    }
+
+    /// Bounds: the base's, widened by the stand-in's amplitude bound (the plan does not know whether a block is ready).
+    fn height_bounds(&self, centre: Vec3, angular_radius: f64) -> (f64, f64) {
+        let (lo, hi) = self.base.height_bounds(centre, angular_radius);
+        (lo - 2.0 * self.params.amp_m, hi + 2.0 * self.params.amp_m)
+    }
+}
