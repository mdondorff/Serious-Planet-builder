+//! SPIKE-28 (M7 I1): instancing at walking height. Scattered instances (grass clumps of 6 triangles, rocks of 80) over a flat ground, drawn at 2560x1440
+//! from an eye 1.8 m high, with the visible set found two ways: the CPU culls every frame (frustum, distance thinning) and uploads the visible instances,
+//! or a GPU compute pass culls a static buffer and writes indirect draw arguments (the CPU reference of `planet_frame::instances` is the oracle:
+//! the two sets must agree). Raw wgpu with its own device; GPU times from timestamps of waited frames, in one process, indicative (no readiness gate,
+//! other programs may run). Throwaway: never merged as it is.
+//!
+//! `cargo run --release -p planet-render --example instancing_spike -- [--adapter hardware] [--frames 100]`
+
+#![allow(clippy::disallowed_methods)]
+
+use std::time::Instant;
+use wgpu::util::DeviceExt;
+
+const W: u32 = 2560;
+const H: u32 = 1440;
+const EYE_M: f32 = 1.8;
+const PITCH_DEG: f32 = 6.0;
+const FOV_DEG: f32 = 60.0;
+const NEAR: f32 = 0.05;
+const FAR: f32 = 600.0;
+/// The side of a cell of the instance index, metres (the CPU culls cells first).
+const CELL_M: f32 = 16.0;
+/// The bounding sphere of an instance before its scale, metres.
+const RADIUS_M: [f32; 2] = [0.7, 0.8];
+const GRASS_VERTS: u32 = 18;
+const ROCK_VERTS: u32 = 240;
+
+fn arg(name: &str) -> Option<String> {
+    let a: Vec<String> = std::env::args().collect();
+    a.iter().position(|x| x == name).and_then(|i| a.get(i + 1).cloned())
+}
+
+// ---------------------------------------------------------------------------------------------------------------------------------------------
+// The scene: placement, the camera, the frustum, the CPU reference of the cull
+
+fn hash(mut x: u32) -> u32 {
+    x ^= x >> 16;
+    x = x.wrapping_mul(0x7feb352d);
+    x ^= x >> 15;
+    x = x.wrapping_mul(0x846ca68b);
+    x ^= x >> 16;
+    x
+}
+
+fn unit(h: u32) -> f32 {
+    (h >> 8) as f32 / 16_777_216.0
+}
+
+/// An instance as the buffers hold it: the place (relative to the region origin, which is where the camera stands: tile-local f32, CON-11) and a
+/// word with the kind (8 bits), the turn (8), the size (8) and the thinning byte (8).
+#[derive(Clone, Copy)]
+struct Inst {
+    p: [f32; 3],
+    w: u32,
+}
+
+impl Inst {
+    fn bytes(&self) -> [u8; 16] {
+        let mut b = [0u8; 16];
+        for k in 0..3 {
+            b[4 * k..4 * k + 4].copy_from_slice(&self.p[k].to_le_bytes());
+        }
+        b[12..16].copy_from_slice(&self.w.to_le_bytes());
+        b
+    }
+
+    fn kind(&self) -> usize {
+        (self.w & 255) as usize
+    }
+}
+
+/// The density input of the placement (the hook for ADR 0076): the suitability of a kind at a place, 0 to 1. `Flat` places everything the scatter
+/// offers; `Patches` is a toy field (soft patches), standing in for a suitability evaluated by the CPU from the driver vector.
+#[derive(Clone, Copy, PartialEq)]
+enum Suitability {
+    Flat,
+    Patches,
+}
+
+impl Suitability {
+    fn at(self, kind: usize, x: f32, z: f32) -> f32 {
+        match self {
+            Suitability::Flat => 1.0,
+            Suitability::Patches => {
+                let k = if kind == 0 { 1.0 / 18.0 } else { 1.0 / 40.0 };
+                (0.5 + 0.5 * (x * k).sin() * (z * k * 1.3).cos()).clamp(0.0, 1.0)
+            }
+        }
+    }
+}
+
+/// `n` candidate places in a disc, 80 % grass clumps and 20 % rocks, each kept with the probability the suitability gives (the placement is a
+/// CPU field: deterministic, the same set on every machine).
+fn scatter(n: usize, suit: Suitability, field_m: f32) -> Vec<Inst> {
+    let mut v = Vec::with_capacity(n);
+    for i in 0..n as u32 {
+        let h0 = hash(i.wrapping_mul(0x9e3779b1) ^ 0x1234);
+        let (h1, h2, h3, h4) = (hash(h0 ^ 1), hash(h0 ^ 2), hash(h0 ^ 3), hash(h0 ^ 4));
+        let kind = usize::from(unit(h0) >= 0.8);
+        let r = field_m * unit(h1).sqrt();
+        let a = std::f32::consts::TAU * unit(h2);
+        let (x, z) = (r * a.cos(), r * a.sin());
+        if unit(h3) >= suit.at(kind, x, z) {
+            continue;
+        }
+        let w = kind as u32 | (((h4 >> 24) & 255) << 8) | (((h4 >> 16) & 255) << 16) | ((hash(h4) >> 24) << 24);
+        v.push(Inst { p: [x, 0.0, z], w });
+    }
+    v
+}
+
+/// The camera: eye at the origin of the region, 1.8 m up, looking north pitched down. Rows of the world-to-clip matrix, and the six frustum planes
+/// (normalised, pointing inside).
+struct Camera {
+    rows: [[f32; 4]; 4],
+    planes: [[f32; 4]; 6],
+    eye: [f32; 3],
+}
+
+fn camera() -> Camera {
+    let eye = [0.0, EYE_M, 0.0];
+    let phi = PITCH_DEG.to_radians();
+    let forward = [0.0, -phi.sin(), phi.cos()];
+    let right = [1.0, 0.0, 0.0];
+    let up = [0.0, phi.cos(), phi.sin()];
+    let dot = |a: [f32; 3], b: [f32; 3]| a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+    let f = 1.0 / (FOV_DEG.to_radians() * 0.5).tan();
+    let aspect = W as f32 / H as f32;
+    let (k1, k0) = (FAR / (FAR - NEAR), -FAR * NEAR / (FAR - NEAR));
+    let row = |v: [f32; 3], s: f32| [v[0] * s, v[1] * s, v[2] * s, -dot(v, eye) * s];
+    let r0 = row(right, f / aspect);
+    let r1 = row(up, f);
+    let mut r2 = row(forward, k1);
+    r2[3] += k0;
+    let r3 = row(forward, 1.0);
+    let add = |a: [f32; 4], b: [f32; 4], s: f32| [a[0] + s * b[0], a[1] + s * b[1], a[2] + s * b[2], a[3] + s * b[3]];
+    let norm = |p: [f32; 4]| {
+        let l = (p[0] * p[0] + p[1] * p[1] + p[2] * p[2]).sqrt();
+        [p[0] / l, p[1] / l, p[2] / l, p[3] / l]
+    };
+    let planes = [add(r3, r0, 1.0), add(r3, r0, -1.0), add(r3, r1, 1.0), add(r3, r1, -1.0), r2, add(r3, r2, -1.0)].map(norm);
+    Camera { rows: [r0, r1, r2, r3], planes, eye }
+}
+
+/// The cull of one instance, the formula of both paths: inside the six planes (with the bounding sphere), and kept by the distance thinning (the
+/// instance's own byte against a keep probability that falls from 1 at half the kind's distance to 0 at the distance).
+fn keeps(cam: &Camera, i: &Inst, lod_m: [f32; 2]) -> bool {
+    let kind = i.kind();
+    let scale = 0.6 + ((i.w >> 16) & 255) as f32 / 255.0 * 0.8;
+    let r = RADIUS_M[kind] * scale;
+    let (dx, dy, dz) = (i.p[0] - cam.eye[0], i.p[1] - cam.eye[1], i.p[2] - cam.eye[2]);
+    let d = (dx * dx + dy * dy + dz * dz).sqrt();
+    let p = ((lod_m[kind] - d) / (0.5 * lod_m[kind])).clamp(0.0, 1.0);
+    if ((i.w >> 24) as f32 + 0.5) / 256.0 >= p {
+        return false;
+    }
+    cam.planes.iter().all(|pl| pl[0] * i.p[0] + pl[1] * i.p[1] + pl[2] * i.p[2] + pl[3] >= -r)
+}
+
+/// The CPU reference: the indices of the kept instances of each kind, ascending.
+fn cull_cpu(cam: &Camera, all: &[Inst], lod_m: [f32; 2]) -> [Vec<u32>; 2] {
+    let mut out = [Vec::new(), Vec::new()];
+    for (k, i) in all.iter().enumerate() {
+        if keeps(cam, i, lod_m) {
+            out[i.kind()].push(k as u32);
+        }
+    }
+    out
+}
+
+/// The instances sorted by cell, and the cells (the index a tile would hold): the cell, where its instances start and how many there are.
+struct Cell {
+    cx: i32,
+    cz: i32,
+    start: usize,
+    len: usize,
+}
+
+fn index_cells(all: &mut Vec<Inst>) -> Vec<Cell> {
+    let key = |i: &Inst| ((i.p[0] / CELL_M).floor() as i32, (i.p[2] / CELL_M).floor() as i32);
+    all.sort_by_key(|i| key(i));
+    let mut cells: Vec<Cell> = Vec::new();
+    for (k, i) in all.iter().enumerate() {
+        let (cx, cz) = key(i);
+        match cells.last_mut() {
+            Some(c) if c.cx == cx && c.cz == cz => c.len += 1,
+            _ => cells.push(Cell { cx, cz, start: k, len: 1 }),
+        }
+    }
+    cells
+}
+
+/// The CPU path as an engine would run it: the cells are tested first (a sphere round the cell against the frustum, the nearest distance against
+/// the largest range), the instances only of the cells that pass. The same set as `cull_cpu`.
+fn cull_cells(cam: &Camera, all: &[Inst], cells: &[Cell], lod_m: [f32; 2]) -> [Vec<u32>; 2] {
+    let mut out = [Vec::new(), Vec::new()];
+    let rc = CELL_M * 0.7072 + 1.2;
+    let range = lod_m[0].max(lod_m[1]);
+    for c in cells {
+        let (x, z) = ((c.cx as f32 + 0.5) * CELL_M, (c.cz as f32 + 0.5) * CELL_M);
+        let (dx, dz) = (x - cam.eye[0], z - cam.eye[2]);
+        if (dx * dx + dz * dz).sqrt() - rc - cam.eye[1] > range {
+            continue;
+        }
+        if !cam.planes.iter().all(|pl| pl[0] * x + pl[2] * z + pl[3] >= -rc - pl[1].abs() * 2.0) {
+            continue;
+        }
+        for k in c.start..c.start + c.len {
+            if keeps(cam, &all[k], lod_m) {
+                out[all[k].kind()].push(k as u32);
+            }
+        }
+    }
+    out
+}
+
+// ---------------------------------------------------------------------------------------------------------------------------------------------
+// The meshes: 18 vertices of a grass clump (three crossed tapered quads), 240 of a rock (an icosphere of 80 faces, flat shaded)
+
+fn meshes() -> (Vec<[f32; 4]>, Vec<[f32; 4]>) {
+    let (mut pos, mut nrm) = (Vec::new(), Vec::new());
+    for q in 0..3 {
+        let a = q as f32 * std::f32::consts::PI / 3.0;
+        let (c, s) = (a.cos(), a.sin());
+        let at = |u: f32, h: f32| [c * u, h, s * u, 0.0];
+        let (b, t, h) = (0.18, 0.03, 0.6);
+        for [u, v] in [[-b, 0.0], [b, 0.0], [-t, h], [-t, h], [b, 0.0], [t, h]] {
+            let mut p = at(u, v);
+            p[3] = v / h;
+            pos.push(p);
+            nrm.push([0.0, 1.0, 0.0, 0.0]);
+        }
+    }
+    // The icosphere.
+    let t = (1.0 + 5f32.sqrt()) / 2.0;
+    let mut v: Vec<[f32; 3]> = vec![
+        [-1.0, t, 0.0],
+        [1.0, t, 0.0],
+        [-1.0, -t, 0.0],
+        [1.0, -t, 0.0],
+        [0.0, -1.0, t],
+        [0.0, 1.0, t],
+        [0.0, -1.0, -t],
+        [0.0, 1.0, -t],
+        [t, 0.0, -1.0],
+        [t, 0.0, 1.0],
+        [-t, 0.0, -1.0],
+        [-t, 0.0, 1.0],
+    ];
+    let f: [[usize; 3]; 20] = [
+        [0, 11, 5],
+        [0, 5, 1],
+        [0, 1, 7],
+        [0, 7, 10],
+        [0, 10, 11],
+        [1, 5, 9],
+        [5, 11, 4],
+        [11, 10, 2],
+        [10, 7, 6],
+        [7, 1, 8],
+        [3, 9, 4],
+        [3, 4, 2],
+        [3, 2, 6],
+        [3, 6, 8],
+        [3, 8, 9],
+        [4, 9, 5],
+        [2, 4, 11],
+        [6, 2, 10],
+        [8, 6, 7],
+        [9, 8, 1],
+    ];
+    let normalise = |p: [f32; 3]| {
+        let l = (p[0] * p[0] + p[1] * p[1] + p[2] * p[2]).sqrt();
+        [p[0] / l, p[1] / l, p[2] / l]
+    };
+    for p in &mut v {
+        *p = normalise(*p);
+    }
+    let mid = |a: [f32; 3], b: [f32; 3]| normalise([(a[0] + b[0]) / 2.0, (a[1] + b[1]) / 2.0, (a[2] + b[2]) / 2.0]);
+    let mut faces: Vec<[[f32; 3]; 3]> = Vec::new();
+    for tri in f {
+        let (a, b, c) = (v[tri[0]], v[tri[1]], v[tri[2]]);
+        let (ab, bc, ca) = (mid(a, b), mid(b, c), mid(c, a));
+        faces.extend([[a, ab, ca], [b, bc, ab], [c, ca, bc], [ab, bc, ca]]);
+    }
+    assert_eq!(faces.len() * 3, ROCK_VERTS as usize);
+    let displace = |p: [f32; 3]| {
+        let h = hash(((p[0] * 997.0) as i32 as u32) ^ (((p[1] * 991.0) as i32 as u32) << 8) ^ (((p[2] * 983.0) as i32 as u32) << 16));
+        let r = 0.42 + 0.18 * unit(h);
+        [p[0] * r, p[1] * r * 0.8 + 0.12, p[2] * r]
+    };
+    for tri in faces {
+        let q = tri.map(displace);
+        let e1 = [q[1][0] - q[0][0], q[1][1] - q[0][1], q[1][2] - q[0][2]];
+        let e2 = [q[2][0] - q[0][0], q[2][1] - q[0][1], q[2][2] - q[0][2]];
+        let n = normalise([e1[1] * e2[2] - e1[2] * e2[1], e1[2] * e2[0] - e1[0] * e2[2], e1[0] * e2[1] - e1[1] * e2[0]]);
+        for p in q {
+            pos.push([p[0], p[1], p[2], 0.5]);
+            nrm.push([n[0], n[1], n[2], 0.0]);
+        }
+    }
+    (pos, nrm)
+}
+
+// ---------------------------------------------------------------------------------------------------------------------------------------------
+// The shaders
+
+const COMMON: &str = r#"
+struct Inst { p: vec3<f32>, w: u32 };
+struct Globals { rows: array<vec4<f32>, 4>, eye: vec4<f32>, sun: vec4<f32> };
+"#;
+
+fn render_shader(gpu_path: bool) -> String {
+    let load = if gpu_path {
+        "fn load_instance(ii: u32) -> Inst { return all_inst[vis[ii]]; }"
+    } else {
+        "fn load_instance(ii: u32) -> Inst { return vis_inst[ii]; }"
+    };
+    let bindings = if gpu_path {
+        "@group(0) @binding(2) var<storage, read> all_inst: array<Inst>;\n@group(0) @binding(3) var<storage, read> vis: array<u32>;"
+    } else {
+        "@group(0) @binding(2) var<storage, read> vis_inst: array<Inst>;"
+    };
+    format!(
+        r#"{COMMON}
+@group(0) @binding(0) var<uniform> g: Globals;
+@group(0) @binding(1) var<storage, read> mesh: array<vec4<f32>, {n}>;
+@group(0) @binding(4) var<storage, read> mesh_n: array<vec4<f32>, {n}>;
+{bindings}
+{load}
+
+struct VsOut {{ @builtin(position) pos: vec4<f32>, @location(0) col: vec3<f32> }};
+
+fn clip_of(p: vec3<f32>) -> vec4<f32> {{
+    let q = vec4<f32>(p, 1.0);
+    return vec4<f32>(dot(g.rows[0], q), dot(g.rows[1], q), dot(g.rows[2], q), dot(g.rows[3], q));
+}}
+
+@vertex
+fn vs(@builtin(vertex_index) vi: u32, @builtin(instance_index) ii: u32) -> VsOut {{
+    let inst = load_instance(ii);
+    let kind = inst.w & 255u;
+    let turn = f32((inst.w >> 8u) & 255u) * (6.2831853 / 256.0);
+    let sc = 0.6 + f32((inst.w >> 16u) & 255u) / 255.0 * 0.8;
+    let tint = f32(inst.w >> 24u) / 255.0;
+    let m = mesh[vi];
+    let c = cos(turn);
+    let s = sin(turn);
+    let local = vec3<f32>(m.x * c - m.z * s, m.y, m.x * s + m.z * c) * sc;
+    let nl = mesh_n[vi].xyz;
+    let n = vec3<f32>(nl.x * c - nl.z * s, nl.y, nl.x * s + nl.z * c);
+    var out: VsOut;
+    out.pos = clip_of(inst.p + local);
+    let lit = 0.35 + 0.65 * max(dot(n, g.sun.xyz), 0.0);
+    var base = vec3<f32>(0.4, 0.38, 0.35) * (0.8 + 0.4 * tint);
+    if (kind == 0u) {{
+        base = mix(vec3<f32>(0.16, 0.32, 0.09), vec3<f32>(0.34, 0.52, 0.16), m.w) * (0.8 + 0.4 * tint);
+    }}
+    out.col = base * lit;
+    return out;
+}}
+
+@fragment
+fn fs(in: VsOut) -> @location(0) vec4<f32> {{
+    return vec4<f32>(in.col, 1.0);
+}}
+
+struct GroundOut {{ @builtin(position) pos: vec4<f32> }};
+
+@vertex
+fn vs_ground(@builtin(vertex_index) vi: u32) -> GroundOut {{
+    var corners = array<vec2<f32>, 6>(vec2<f32>(-1.0, -1.0), vec2<f32>(1.0, -1.0), vec2<f32>(-1.0, 1.0), vec2<f32>(-1.0, 1.0), vec2<f32>(1.0, -1.0), vec2<f32>(1.0, 1.0));
+    let c = corners[vi] * 400.0;
+    var out: GroundOut;
+    out.pos = clip_of(vec3<f32>(c.x, 0.0, c.y));
+    return out;
+}}
+
+@fragment
+fn fs_ground() -> @location(0) vec4<f32> {{
+    return vec4<f32>(0.33, 0.31, 0.22, 1.0);
+}}
+"#,
+        n = GRASS_VERTS + ROCK_VERTS,
+    )
+}
+
+const CULL_SHADER: &str = r#"
+struct Inst { p: vec3<f32>, w: u32 };
+struct Cull { planes: array<vec4<f32>, 6>, eye: vec4<f32>, lod: vec4<f32>, radius: vec4<f32>, n: u32, pad0: u32, pad1: u32, pad2: u32 };
+@group(0) @binding(0) var<uniform> c: Cull;
+@group(0) @binding(1) var<storage, read> all_inst: array<Inst>;
+@group(0) @binding(2) var<storage, read_write> vis_grass: array<u32>;
+@group(0) @binding(3) var<storage, read_write> vis_rock: array<u32>;
+@group(0) @binding(4) var<storage, read_write> args: array<atomic<u32>>;
+
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>) {
+    let i = id.x;
+    if (i >= c.n) {
+        return;
+    }
+    let inst = all_inst[i];
+    let kind = inst.w & 255u;
+    let scale = 0.6 + f32((inst.w >> 16u) & 255u) / 255.0 * 0.8;
+    let lod = select(c.lod.x, c.lod.y, kind == 1u);
+    let r = select(c.radius.x, c.radius.y, kind == 1u) * scale;
+    let d3 = inst.p - c.eye.xyz;
+    let d = sqrt(dot(d3, d3));
+    let p = clamp((lod - d) / (0.5 * lod), 0.0, 1.0);
+    if ((f32(inst.w >> 24u) + 0.5) / 256.0 >= p) {
+        return;
+    }
+    for (var k = 0u; k < 6u; k = k + 1u) {
+        let pl = c.planes[k];
+        if (pl.x * inst.p.x + pl.y * inst.p.y + pl.z * inst.p.z + pl.w < -r) {
+            return;
+        }
+    }
+    if (kind == 0u) {
+        let slot = atomicAdd(&args[1], 1u);
+        vis_grass[slot] = i;
+    } else {
+        let slot = atomicAdd(&args[5], 1u);
+        vis_rock[slot] = i;
+    }
+}
+"#;
+
+// ---------------------------------------------------------------------------------------------------------------------------------------------
+// The harness
+
+struct Gpu {
+    device: wgpu::Device,
+    queue: wgpu::Queue,
+    period_ns: f64,
+}
+
+struct Timing {
+    queries: wgpu::QuerySet,
+    resolve: wgpu::Buffer,
+    readback: wgpu::Buffer,
+}
+
+fn storage(device: &wgpu::Device, label: &str, size: u64, extra: wgpu::BufferUsages) -> wgpu::Buffer {
+    device.create_buffer(&wgpu::BufferDescriptor {
+        label: Some(label),
+        size: size.max(16),
+        usage: wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_DST | extra,
+        mapped_at_creation: false,
+    })
+}
+
+fn read_back(gpu: &Gpu, src: &wgpu::Buffer, bytes: u64) -> Vec<u8> {
+    let staging = gpu.device.create_buffer(&wgpu::BufferDescriptor {
+        label: Some("readback"),
+        size: bytes.max(4),
+        usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+        mapped_at_creation: false,
+    });
+    let mut enc = gpu.device.create_command_encoder(&wgpu::CommandEncoderDescriptor { label: Some("readback") });
+    enc.copy_buffer_to_buffer(src, 0, &staging, 0, bytes);
+    gpu.queue.submit([enc.finish()]);
+    let slice = staging.slice(..);
+    slice.map_async(wgpu::MapMode::Read, |r| r.expect("map"));
+    gpu.device.poll(wgpu::PollType::wait_indefinitely()).expect("poll");
+    let out = slice.get_mapped_range().expect("range").to_vec();
+    out
+}
+
+fn median(v: &mut [f64]) -> f64 {
+    v.sort_by(|a, b| a.total_cmp(b));
