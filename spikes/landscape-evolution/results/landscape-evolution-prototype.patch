+        "sweep" => exp::sweep(arg(&a, 2, 1024usize), arg(&a, 3, 30usize), arg(&a, 4, 4usize), &out),
+        "oracle" => exp::oracle(arg(&a, 2, 1024usize), arg(&a, 3, 100usize), arg(&a, 4, 4usize), &out),
+        "variants" => exp::variants(arg(&a, 2, 1024usize), arg(&a, 3, 100usize), arg(&a, 4, 4usize), &out),
+        "look" => look::look(arg(&a, 2, 1024usize), arg(&a, 3, 100usize), arg(&a, 4, 6usize), &out),
+        "lod" => look::lod(arg(&a, 2, 1024usize), arg(&a, 3, 100usize), arg(&a, 4, 6usize), &out),
+        "seams" => seams::seams(arg(&a, 2, 1024usize), arg(&a, 3, 100usize), arg(&a, 4, 6usize), &out, false),
